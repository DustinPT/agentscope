{
  "network": {
    "allowedDomains": [
      "pypi.org",
      "pythonhosted.org",
      "*.pythonhosted.org",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "codeload.github.com",
      "registry.npmjs.org",
      "*.npmjs.org",
      "nodejs.org",
      "*.nodejs.org",
      "registry.yarnpkg.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/home",
      "/root"
    ],
    "allowRead": [
      "/tmp",
      "/var/tmp",
      "~/.cache/uv",
      "~/.cache/mise",
      "~/.local/share/uv",
      "~/.local/share/mise",
      "~/.local/bin",
      "~/.config/mise",
      "~/.npm",
      "~/.cache/npm",
      "~/.cache/npx",
      "~/.cache/node",
      "~/.node-gyp"
    ],
    "allowWrite": [
      "/tmp",
      "/var/tmp",
      "~/.cache/uv",
      "~/.cache/mise",
      "~/.local/share/uv",
      "~/.local/share/mise",
      "~/.local/bin",
      "~/.config/mise",
      "~/.npm",
      "~/.cache/npm",
      "~/.cache/npx",
      "~/.cache/node",
      "~/.node-gyp"
    ],
    "denyWrite": []
  }
}
