{
  "network": {
    "allowedDomains": [
      "pypi.org",
      "pythonhosted.org",
      "*.pythonhosted.org",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "codeload.github.com",
      "registry.npmjs.org",
      "*.npmjs.org",
      "nodejs.org",
      "*.nodejs.org",
      "registry.yarnpkg.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "C:/Users"
    ],
    "allowRead": [
      "C:/Windows/Temp",
      "~/AppData/Local/Temp",
      "~/AppData/Local/uv",
      "~/AppData/Local/uv/cache",
      "~/AppData/Local/mise",
      "~/AppData/Local/mise/cache",
      "~/AppData/Local/npm-cache",
      "~/AppData/Local/npx-cache",
      "~/AppData/Local/node-gyp",
      "~/AppData/Roaming/npm",
      "~/AppData/Roaming/mise"
    ],
    "allowWrite": [
      "C:/Windows/Temp",
      "~/AppData/Local/Temp",
      "~/AppData/Local/uv",
      "~/AppData/Local/uv/cache",
      "~/AppData/Local/mise",
      "~/AppData/Local/mise/cache",
      "~/AppData/Local/npm-cache",
      "~/AppData/Local/npx-cache",
      "~/AppData/Local/node-gyp",
      "~/AppData/Roaming/npm",
      "~/AppData/Roaming/mise"
    ],
    "denyWrite": []
  }
}
