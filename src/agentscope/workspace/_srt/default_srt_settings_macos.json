{
  "network": {
    "allowedDomains": [
      "pypi.org",
      "pythonhosted.org",
      "*.pythonhosted.org",
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "codeload.github.com",
      "registry.npmjs.org",
      "*.npmjs.org",
      "nodejs.org",
      "*.nodejs.org",
      "registry.yarnpkg.com",
      "mirrors.tuna.tsinghua.edu.cn"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/Users"
    ],
    "allowRead": [
      "/tmp",
      "/private/tmp",
      "/var/tmp",
      "/private/var/tmp",
      "/private/var/folders",
      "~/.cache/uv",
      "~/.cache/mise",
      "~/.cache/pip",
      "~/.local/share/uv",
      "~/.local/share/mise",
      "~/.local/bin",
      "~/.config/mise",
      "~/.npm",
      "~/.cache/npm",
      "~/.cache/npx",
      "~/.cache/node",
      "~/.node-gyp",
      "~/Library/Caches/uv",
      "~/Library/Caches/pip",
      "~/Library/Caches/npm",
      "~/Library/Caches/npx",
      "~/Library/Caches/node",
      "~/Library/Application Support/uv",
      "~/Library/Application Support/npm"
    ],
    "allowWrite": [
      "/tmp",
      "/private/tmp",
      "/var/tmp",
      "/private/var/tmp",
      "/private/var/folders",
      "~/.cache/uv",
      "~/.cache/mise",
      "~/.cache/pip",
      "~/.local/share/uv",
      "~/.local/share/mise",
      "~/.local/bin",
      "~/.config/mise",
      "~/.npm",
      "~/.cache/npm",
      "~/.cache/npx",
      "~/.cache/node",
      "~/.node-gyp",
      "~/Library/Caches/uv",
      "~/Library/Caches/pip",
      "~/Library/Caches/npm",
      "~/Library/Caches/npx",
      "~/Library/Caches/node",
      "~/Library/Application Support/uv",
      "~/Library/Application Support/npm"
    ],
    "denyWrite": []
  }
}
